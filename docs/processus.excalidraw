    {
      "id": "aTAB",
      "type": "text",
      "x": 40,
      "y": 1477.5,
      "width": 1209.375,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
