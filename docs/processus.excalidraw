      "boundElements": [],
      "updated": 1795770054155,
      "link": null,
      "locked": false,
      "text": "Chaque libellé est comparé à environ\n260 expressions régulières, écrites\nà partir de la liste annotée\ntransmise par la DRTI. Les règles\nqui ont décidé sont notées dans la\ncolonne regex_rules.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Chaque libellé est comparé à environ\n260 expressions régulières, écrites\nà partir de la liste annotée\ntransmise par la DRTI. Les règles\nqui ont décidé sont notées dans la\ncolonne regex_rules.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aJ"
    },
