  {
   "id": "NOTE",
   "type": "text",
   "x": 40,
   "y": 66,
   "width": 1402.8749999999998,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 158696257,
   "version": 1,
   "versionNonce": 65911073,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Un run = une exécution de « uv run run.py <fichier> ». Flèches pleines : le chemin d'une ligne du fichier. Pointillés : ce qui est lu en plus (nomenclature, réglages, cache).",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "Un run = une exécution de « uv run run.py <fichier> ». Flèches pleines : le chemin d'une ligne du fichier. Pointillés : ce qui est lu en plus (nomenclature, réglages, cache).",
   "lineHeight": 1.25,
   "autoResize": true
  },
