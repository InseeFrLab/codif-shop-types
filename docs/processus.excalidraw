    {
      "id": "NOTE",
      "type": "text",
      "x": 40,
      "y": 66,
      "width": 1402.8749999999998,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
